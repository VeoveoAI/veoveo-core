{
  "AccessLevel": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "A capability level. Ordered `Read < Write < Admin`, so `min` yields the\nlesser privilege — exactly what capping a group role by a grant level needs.",
    "enum": [
      "read",
      "write",
      "admin"
    ],
    "title": "AccessLevel",
    "type": "string"
  },
  "InvocationAuthority": {
    "$defs": {
      "DelegationId": {
        "description": "Auditable identity of authority delegated by an initiator to another actor.",
        "type": "string"
      },
      "InvocationProvenance": {
        "description": "Provenance retained across synchronous and asynchronous execution.",
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "initiator": {
                "$ref": "#/$defs/PrincipalId"
              },
              "mode": {
                "const": "direct",
                "type": "string"
              }
            },
            "required": [
              "mode",
              "initiator"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "delegation_id": {
                "$ref": "#/$defs/DelegationId"
              },
              "initiator": {
                "$ref": "#/$defs/PrincipalId"
              },
              "mode": {
                "const": "delegated",
                "type": "string"
              }
            },
            "required": [
              "mode",
              "initiator",
              "delegation_id"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "mode": {
                "const": "automated",
                "type": "string"
              }
            },
            "required": [
              "mode"
            ],
            "type": "object"
          }
        ]
      },
      "PolicyVersion": {
        "description": "Immutable policy version identifier emitted with decisions and audit records.",
        "type": "string"
      },
      "PrincipalId": {
        "description": "Stable authenticated user or service-principal identity.",
        "type": "string"
      },
      "TenantId": {
        "description": "Tenant, organization, or customer boundary identifier.",
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Invocation authority resolved at admission and signed into every forwarded identity.",
    "properties": {
      "policy_revision": {
        "$ref": "#/$defs/PolicyVersion"
      },
      "provenance": {
        "$ref": "#/$defs/InvocationProvenance"
      },
      "tenant": {
        "$ref": "#/$defs/TenantId"
      }
    },
    "required": [
      "tenant",
      "policy_revision",
      "provenance"
    ],
    "title": "InvocationAuthority",
    "type": "object"
  }
}

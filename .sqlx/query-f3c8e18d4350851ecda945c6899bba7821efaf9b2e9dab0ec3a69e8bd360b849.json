{
  "db_name": "PostgreSQL",
  "query": "-- One page of a partition's daily counts, newest day first, then by class and outcome.\nSELECT\n    d.day AS \"day!\",\n    d.class AS \"class!: AuditClass\",\n    d.outcome AS \"outcome!: AuditOutcome\",\n    d.count AS \"count!\"\nFROM audit.daily AS d\nWHERE d.partition = $1\n    AND d.day >= $2\n    AND d.day < $3\n    AND (\n        $4::timestamptz IS NULL\n        OR d.day < $4\n        OR (d.day = $4 AND d.class > $5)\n        OR (d.day = $4 AND d.class = $5 AND d.outcome > $6)\n    )\nORDER BY d.day DESC, d.class, d.outcome\nLIMIT $7\n",

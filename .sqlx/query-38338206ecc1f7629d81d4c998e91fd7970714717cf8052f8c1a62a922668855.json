{
  "db_name": "PostgreSQL",
  "query": "-- The members of one sealed block that match a query, every filter applied in SQL.\nSELECT\n    r.id AS \"id: AuditRecordId\",\n    r.partition,\n    r.class AS \"class: AuditClass\",\n    r.occurred_at,\n    r.draft,\n    r.recorded_at\nFROM audit.record AS r\nWHERE r.partition = $1\n    AND r.id = ANY ($2)\n    AND ($3::uuid IS NULL OR r.id > $3)\n    AND ($4::text IS NULL OR r.class = $4)\n    AND ($5::text IS NULL OR r.actor = $5)\n    AND ($6::jsonb IS NULL OR r.draft -> 'target' = $6)\n    AND ($7::text IS NULL OR r.outcome = $7)\n    AND ($8::text IS NULL OR r.trace_id = $8)\n    AND ($9::timestamptz IS NULL OR r.occurred_at >= $9)\n    AND ($10::timestamptz IS NULL OR r.occurred_at < $10)\n",

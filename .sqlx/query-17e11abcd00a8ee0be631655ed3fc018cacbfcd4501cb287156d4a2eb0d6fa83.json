{
  "db_name": "PostgreSQL",
  "query": "-- The caller's own committed audit-view receipt for the partition, if it is current.\nSELECT\n    r.id AS \"id: AuditRecordId\",\n    r.partition,\n    r.class AS \"class: AuditClass\",\n    r.occurred_at,\n    r.draft,\n    r.recorded_at\nFROM audit.record AS r\nWHERE r.id = $1\n    AND r.partition = $2\n    AND r.actor = $3\n    AND r.profile = $4\n    AND r.draft -> 'target' = $5\n    AND r.draft -> 'detail' = $6\n    AND r.outcome = 'allowed'\n    AND r.occurred_at > now() - interval '15 minutes'\n",
